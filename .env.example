# ── OpenAI - powers Scout's LLM reasoning ────────────────────────────────────
OPENAI_API_KEY=sk-...
# Model used for the agent loop (gpt-4o or gpt-4.1 recommended)
OPENAI_MODEL=gpt-4o

# ── Session secret - REQUIRED in production ──────────────────────────────────
# Seals each visitor's ClickHouse credentials into an httpOnly cookie (AES-256-GCM),
# so the server holds no connection state of its own. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If unset, Scout falls back to a per-process key and everyone has to re-link their
# database after every restart or deploy.
SCOUT_SECRET=

# ── Optional: allow private / localhost ClickHouse endpoints ─────────────────
# Scout refuses to dial loopback, private and link-local addresses, so a public
# deployment can't be pointed at its own internal network (or a cloud metadata
# endpoint). Set to 1 when self-hosting against a ClickHouse on your own machine
# or LAN.
# SCOUT_ALLOW_PRIVATE_HOSTS=1

# NOTE: there is no CLICKHOUSE_HOST / USER / PASSWORD / DATABASE any more. Scout ships
# with no warehouse of its own - each visitor links their own database through the
# in-app setup tour, and it is remembered until they disconnect.
